# Build output
node_modules/
web/dist/
build/
macos/.build/
*.dSYM/

# macOS, editors
.DS_Store
*.swp
.idea/
.vscode/
xcuserdata/

# Never commit a plan with real device IDs, or any credentials.
# The app keeps these in ~/Library/Application Support/HouseControl, outside the repository.
plan.json
plan.backup*.json
smartlife.json
tuya.json
events.log
.env
.env.*

# Local assistant settings
.claude/settings.local.json

# iPhone app: the Xcode project and Info.plist are generated from ios/project.yml (xcodegen),
# and the signing team is personal.
ios/HouseControl.xcodeproj/
ios/Config/Info.plist
ios/Config/HouseControl.entitlements
ios/Config/Local.xcconfig
ios/build/
core/.build/
sync.json

# Widgets: the Mac extension's Xcode project, Info.plists and entitlements are generated
# from widgets/project.yml and ios/project.yml.
widgets/HouseWidgetsMac.xcodeproj/
widgets/Config/Info-*.plist
widgets/Config/*.entitlements
widgets/build/
widgets/.build/
