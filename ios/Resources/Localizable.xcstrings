    "The iPad got too warm to scan. Let it cool down a little." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das iPad ist zum Scannen zu warm geworden. Lass es etwas abkühlen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το iPad ζεστάθηκε πολύ για σάρωση. Αφήστε το να κρυώσει λίγο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El iPad se ha calentado demasiado para escanear. Deja que se enfríe un poco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’iPad est devenu trop chaud pour scanner. Laissez-le refroidir un peu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’iPad si è scaldato troppo per la scansione. Lascialo raffreddare un po’."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPadが熱くなりすぎたためスキャンできません。少し冷ましてください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad слишком нагрелся для сканирования. Дайте ему немного остыть."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad tarama için fazla ısındı. Biraz soğumasını bekleyin."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad 過熱，無法掃描。請讓它稍微降溫。"
          }
        }
      }
    },
    "The iPad is getting warm: finish this room soon" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das iPad wird warm: Schließ diesen Raum bald ab"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το iPad ζεσταίνεται: ολοκληρώστε σύντομα αυτό το δωμάτιο"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El iPad se está calentando: termina pronto esta habitación"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’iPad chauffe : terminez vite cette pièce"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’iPad si sta scaldando: termina presto questa stanza"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPadが熱くなってきました：この部屋を早めに終えてください"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad нагревается: скорее заканчивайте эту комнату"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad ısınıyor: bu odayı yakında bitirin"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad 正在變熱：請盡快完成此房間"
          }
        }
      }
    },
    "The iPad is too warm: finishing the scan" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das iPad ist zu warm: Scan wird beendet"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το iPad είναι πολύ ζεστό: ολοκλήρωση σάρωσης"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El iPad está demasiado caliente: terminando el escaneo"
