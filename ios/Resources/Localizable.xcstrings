          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le credenziali restano su questo iPhone, nel Portachiavi, e arrivano al computer abbinato tramite il collegamento crittografato, così House Control può accedere di nuovo quando la sessione di Homebridge scade."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインイン情報はこのiPhoneのキーチェーンに保存され、暗号化されたリンクでペアリングしたコンピュータにも送られます。Homebridgeのセッションが切れても、House Controlがもう一度サインインできます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данные для входа хранятся на этом iPhone в связке ключей и передаются на связанный компьютер по вашему зашифрованному каналу, чтобы House Control мог войти снова, когда сеанс Homebridge закончится."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturum bilgileri bu iPhone’da, Anahtar Zinciri’nde kalır ve şifreli bağlantınız üzerinden eşlediğiniz bilgisayara gider; böylece Homebridge oturumu sona erdiğinde House Control yeniden oturum açabilir."
          }
        },
        "zh-Hant" : {
