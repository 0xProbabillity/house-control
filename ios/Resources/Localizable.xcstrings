    "Now link the lamps and air conditioners of your plan to your devices: Settings → Devices, or in the editor." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verknüpfe jetzt die Lampen und Klimaanlagen deines Plans mit deinen Geräten: Einstellungen → Geräte oder im Editor."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τώρα συνδέστε τα φωτιστικά και τα κλιματιστικά της κάτοψής σας με τις συσκευές σας: Ρυθμίσεις → Συσκευές ή στον επεξεργαστή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora vincula las lámparas y los aires acondicionados de tu plano a tus dispositivos: Ajustes → Dispositivos, o en el editor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liez maintenant les lampes et climatiseurs de votre plan à vos appareils : Réglages → Appareils, ou dans l’éditeur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ora collega le lampade e i condizionatori della piantina ai tuoi dispositivi: Impostazioni → Dispositivi, oppure nell’editor."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次に、間取りのライトとエアコンをデバイスにリンクしましょう：「設定」→「デバイス」、またはエディタで。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Теперь привяжите лампы и кондиционеры плана к своим устройствам: Настройки → «Устройства» или в редакторе."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şimdi planınızdaki lambaları ve klimaları cihazlarınıza bağlayın: Ayarlar → Cihazlar ya da düzenleyicide."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
