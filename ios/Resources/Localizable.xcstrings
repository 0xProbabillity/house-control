    "Linking a device turns this demo into your own home, saved on this iPad." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobald du ein Gerät verknüpfst, wird diese Demo zu deinem eigenen Zuhause, gesichert auf diesem iPad."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μόλις συνδέσετε μια συσκευή, η επίδειξη γίνεται το δικό σας σπίτι, αποθηκευμένο σε αυτό το iPad."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al vincular un dispositivo, esta demo se convierte en tu propia casa, guardada en este iPad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lier un appareil transforme cette démo en votre propre domicile, enregistré sur cet iPad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collegando un dispositivo, questa demo diventa la tua casa, salvata su questo iPad."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイスをリンクすると、このデモがあなたのホームになり、このiPadに保存されます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если привязать устройство, это демо станет вашим домом и сохранится на этом iPad."
