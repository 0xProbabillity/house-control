    "Connect Home Assistant, Philips Hue, Homebridge or Apple Home in Settings first; their devices then appear here to choose from." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde zuerst Home Assistant, Philips Hue, Homebridge oder Apple Home in den Einstellungen; ihre Geräte erscheinen dann hier zur Auswahl."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνδέστε πρώτα Home Assistant, Philips Hue, Homebridge ή Apple Home στις Ρυθμίσεις· οι συσκευές τους θα εμφανιστούν εδώ για επιλογή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero conecta Home Assistant, Philips Hue, Homebridge o Apple Home en Ajustes; sus dispositivos aparecerán aquí para elegir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez d’abord Home Assistant, Philips Hue, Homebridge ou Apple Home dans Réglages ; leurs appareils apparaîtront ici pour que vous puissiez choisir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima connetti Home Assistant, Philips Hue, Homebridge o Apple Home in Impostazioni; i loro dispositivi appariranno qui da scegliere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先に「設定」でHome Assistant、Philips Hue、Homebridge、Apple Homeのいずれかに接続してください。そのデバイスがここに表示され、選択できるようになります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала подключите Home Assistant, Philips Hue, Homebridge или Apple Home в Настройках — тогда их устройства появятся здесь для выбора."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önce Ayarlar’da Home Assistant, Philips Hue, Homebridge veya Apple Home’u bağlayın; cihazları seçmeniz için burada görünür."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
