    "Rooms scanned so far are lost unless you finish." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bisher gescannte Räume gehen verloren, wenn du nicht abschließt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα δωμάτια που σαρώθηκαν ως τώρα χάνονται αν δεν ολοκληρώσετε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las habitaciones escaneadas hasta ahora se pierden si no terminas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pièces déjà scannées seront perdues si vous ne terminez pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le stanze scansionate finora andranno perse se non concludi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完了しないと、ここまでスキャンした部屋は失われます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если не завершить, отсканированные комнаты пропадут."
          }
        },
