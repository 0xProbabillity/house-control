          "stringUnit" : {
            "state" : "translated",
            "value" : "Stanze, lampade e condizionatori, su questo iPad. Abbina un Mac o PC quando vuoi: restano sincronizzati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部屋、ライト、エアコンをこのiPadで。MacやPCとはいつでもペアリングでき、両方が同期します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Комнаты, лампы и кондиционеры — на этом iPad. Свяжите с Mac или ПК в любой момент: они будут синхронизированы."
          }
