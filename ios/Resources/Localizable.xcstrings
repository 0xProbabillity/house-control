    "“%@” was changed both here and on %@ since they last synced. The one you keep replaces the other on both." : {
      "comment" : "Alert; the placeholders are the home's name and the paired computer's name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ wurde seit der letzten Synchronisierung sowohl hier als auch auf %2$@ geändert. Das, das du behältst, ersetzt das andere auf beiden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το «%1$@» άλλαξε και εδώ και στο %2$@ από τον τελευταίο συγχρονισμό. Αυτό που θα κρατήσετε αντικαθιστά το άλλο και στα δύο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "“%1$@” was changed both here and on %2$@ since they last synced. The one you keep replaces the other on both."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» se ha cambiado aquí y en %2$@ desde la última sincronización. El que conserves sustituirá al otro en los dos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %1$@ » a été modifié ici et sur %2$@ depuis la dernière synchro. Celui que vous gardez remplace l’autre sur les deux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” è stata modificata sia qui sia su %2$@ dall’ultima sincronizzazione. Quella che mantieni sostituisce l’altra su entrambi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」は前回の同期以降、ここと%2$@の両方で変更されました。残した方が、両方でもう一方を置き換えます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» изменён и здесь, и на %2$@ после последней синхронизации. Тот, что вы оставите, заменит другой на обоих."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”, son eşzamanlamadan bu yana hem burada hem de %2$@ cihazında değişti. Tuttuğunuz, ikisinde de diğerinin yerini alır."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」自上次同步後在這裡和 %2$@ 上都有變更。你保留的那個會在兩邊取代另一個。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
