    "RoomPlan sees walls best in a well lit room. Open the doors you will walk through." : {
      "comment" : "Scan tips; RoomPlan is Apple's scanning technology, keep the name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RoomPlan erkennt Wände am besten in einem hellen Raum. Öffne die Türen, durch die du gehen wirst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το RoomPlan αναγνωρίζει καλύτερα τους τοίχους σε καλά φωτισμένο δωμάτιο. Ανοίξτε τις πόρτες από τις οποίες θα περάσετε."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RoomPlan detecta mejor las paredes en una habitación bien iluminada. Abre las puertas por las que vayas a pasar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RoomPlan détecte mieux les murs dans une pièce bien éclairée. Ouvrez les portes que vous allez franchir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RoomPlan riconosce meglio le pareti in una stanza ben illuminata. Apri le porte che attraverserai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RoomPlanは明るい部屋で壁をよく認識します。通るドアは開けておいてください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RoomPlan лучше видит стены в хорошо освещённой комнате. Откройте двери, через которые будете проходить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RoomPlan duvarları iyi aydınlatılmış bir odada en iyi görür. İçinden geçeceğiniz kapıları açın."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RoomPlan 在光線充足的房間中最能辨識牆面。請打開你要經過的門。"
          }
        }
      }
    },
