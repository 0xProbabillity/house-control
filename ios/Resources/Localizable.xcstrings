    },
    "The camera opens next. Nothing here changes until you save the scan." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als Nächstes öffnet sich die Kamera. Hier ändert sich nichts, bis du den Scan sicherst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στη συνέχεια ανοίγει η κάμερα. Τίποτα δεν αλλάζει εδώ μέχρι να αποθηκεύσετε τη σάρωση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora se abrirá la cámara. Aquí no cambia nada hasta que guardes el escaneo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’appareil photo s’ouvre ensuite. Rien ne change ici tant que vous n’enregistrez pas le scan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poi si apre la fotocamera. Qui non cambia nulla finché non salvi la scansione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次にカメラが開きます。スキャンを保存するまで、ここは何も変わりません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дальше откроется камера. Здесь ничего не изменится, пока вы не сохраните скан."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sırada kamera açılacak. Taramayı kaydedene kadar burada hiçbir şey değişmez."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接下來會開啟相機。在你儲存掃描前，這裡不會有任何變更。"
          }
        }
      }
    },
    "The code expired before it was scanned. Show a new one." : {
      "comment" : "Smart Life: the sign-in QR code timed out",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Code ist abgelaufen, bevor er gescannt wurde. Zeig einen neuen an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο κωδικός έληξε πριν σαρωθεί. Εμφανίστε νέο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El código ha caducado antes de escanearse. Muestra uno nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le code a expiré avant d’être scanné. Affichez-en un nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il codice è scaduto prima di essere scansionato. Mostrane uno nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スキャンされる前にコードの有効期限が切れました。新しいコードを表示してください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Срок действия кода истёк до сканирования. Покажите новый."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodun süresi taranmadan doldu. Yeni bir kod gösterin."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代碼在掃描前已過期。請顯示新的代碼。"
          }
        }
      }
    },
    "The code is on %@" : {
