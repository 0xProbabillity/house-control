          }
        }
      }
    },
    "Rooms, lamps and ACs, on this iPad. Pair a Mac or PC any time: both stay in sync." : {
      "comment" : "Welcome screen",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Räume, Lampen und Klimaanlagen auf diesem iPad. Kopple jederzeit einen Mac oder PC: Beide bleiben synchron."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δωμάτια, φωτιστικά και κλιματιστικά, σε αυτό το iPad. Κάντε σύζευξη με Mac ή PC όποτε θέλετε: μένουν συγχρονισμένα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Habitaciones, lámparas y aires acondicionados, en este iPad. Enlaza un Mac o PC cuando quieras: los dos se mantienen sincronizados."
          }
