    "No bridge found by itself. Type its address below — the Hue app shows it under Settings → My Hue System." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Bridge automatisch gefunden. Gib ihre Adresse unten ein – die Hue-App zeigt sie unter Einstellungen → Mein Hue System."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν βρέθηκε αυτόματα κανένα Bridge. Πληκτρολογήστε τη διεύθυνσή του παρακάτω — η εφαρμογή Hue τη δείχνει στις Ρυθμίσεις → Το σύστημα Hue μου."
          }
        },
        "es" : {
          "stringUnit" : {
