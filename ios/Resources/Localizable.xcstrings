    "Tap Next room in the doorway: every room lands in the same plan, lined up." : {
      "comment" : "Scan tips; Next room is the scan screen's button",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe in der Tür auf „Nächster Raum“: Jeder Raum landet ausgerichtet im selben Plan."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αγγίξτε Επόμενο στην πόρτα: κάθε δωμάτιο μπαίνει στην ίδια κάτοψη, ευθυγραμμισμένο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca Siguiente en la puerta: cada habitación cae en el mismo plano, alineada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez Pièce suivante sur le pas de la porte : chaque pièce s’ajoute au même plan, alignée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca Stanza successiva sulla porta: ogni stanza finisce nella stessa piantina, allineata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出入口で「次の部屋」をタップ：すべての部屋が同じ間取りに、位置を合わせて入ります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В дверном проёме нажмите «Следующая»: все комнаты попадут в один план и выстроятся по местам."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapı eşiğinde Sonraki oda’ya dokunun: her oda aynı plana hizalı olarak yerleşir."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在門口點一下「下一個房間」：每個房間都會對齊放進同一張平面圖。"
          }
        }
      }
    },
    "Tap a lamp, drag to dim" : {
