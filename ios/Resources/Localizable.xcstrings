    "Point the circle at a lamp or an air conditioner and tap +, then pick the real device." : {
      "comment" : "Scan tips; + is the scan screen's button",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richte den Kreis auf eine Lampe oder Klimaanlage, tippe auf + und wähle dann das echte Gerät."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στρέψτε τον κύκλο σε ένα φωτιστικό ή κλιματιστικό και αγγίξτε +, μετά επιλέξτε την πραγματική συσκευή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apunta el círculo a una lámpara o un aire acondicionado y toca +; luego elige el dispositivo real."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pointez le cercle vers une lampe ou un climatiseur et touchez +, puis choisissez l’appareil réel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punta il cerchio su una lampada o un condizionatore e tocca +, poi scegli il dispositivo reale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "円をライトかエアコンに向けて+をタップし、実際のデバイスを選びます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наведите круг на лампу или кондиционер, нажмите + и выберите реальное устройство."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daireyi bir lambaya veya klimaya doğrultup + düğmesine dokunun, ardından gerçek cihazı seçin."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將圓圈對準燈或冷氣並點一下 +，然後選擇真實裝置。"
          }
        }
      }
    },
    "Point this iPad at the code. Both devices need to be on the same Wi-Fi." : {
