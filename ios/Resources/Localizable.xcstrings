    "The editor" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Editor"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο επεξεργαστής"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El editor"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’éditeur"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’editor"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エディタ"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Редактор"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düzenleyici"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "編輯器"
          }
        }
      }
    },
    "The editor opens next: drag rooms and lamps with a finger, pinch to zoom. Lamps and air conditioners stay simulated until you link them to your real devices." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als Nächstes öffnet sich der Editor: Zieh Räume und Lampen mit einem Finger, zoome mit zwei Fingern. Lampen und Klimaanlagen bleiben simuliert, bis du sie mit deinen echten Geräten verknüpfst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στη συνέχεια ανοίγει ο επεξεργαστής: σύρετε δωμάτια και φωτιστικά με το δάχτυλο, τσιμπήστε για ζουμ. Τα φωτιστικά και τα κλιματιστικά μένουν σε προσομοίωση μέχρι να τα συνδέσετε με τις πραγματικές σας συσκευές."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora se abrirá el editor: arrastra habitaciones y lámparas con un dedo y pellizca para hacer zoom. Las lámparas y los aires acondicionados siguen simulados hasta que los vincules a tus dispositivos reales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’éditeur s’ouvre ensuite : faites glisser pièces et lampes du doigt, pincez pour zoomer. Les lampes et climatiseurs restent simulés tant que vous ne les liez pas à vos appareils réels."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poi si apre l’editor: trascina stanze e lampade con un dito, pizzica per lo zoom. Lampade e condizionatori restano simulati finché non li colleghi ai tuoi dispositivi reali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次にエディタが開きます：部屋やライトを指でドラッグし、ピンチでズームします。ライトとエアコンは、実際のデバイスにリンクするまでシミュレーションのままです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дальше откроется редактор: двигайте комнаты и лампы пальцем, масштаб — щипком. Лампы и кондиционеры остаются имитацией, пока вы не привяжете их к реальным устройствам."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sırada düzenleyici açılacak: odaları ve lambaları parmağınızla sürükleyin, yakınlaştırmak için kıstırın. Lambalar ve klimalar siz onları gerçek cihazlarınıza bağlayana kadar simüle edilir."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接下來會開啟編輯器：用手指拖移房間和燈，雙指開合以縮放。燈和冷氣在連結到真實裝置之前都會保持模擬。"
          }
        }
      }
    },
    "The floor plan stays on this iPad but no longer follows the computer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Grundriss bleibt auf diesem iPad, folgt aber nicht mehr dem Computer."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η κάτοψη μένει σε αυτό το iPad, αλλά δεν ακολουθεί πια τον υπολογιστή."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El plano se queda en este iPad, pero ya no sigue al ordenador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le plan reste sur cet iPad mais ne suit plus l’ordinateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La piantina resta su questo iPad ma non segue più il computer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "間取りはこのiPadに残りますが、コンピュータとは同期しなくなります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "План останется на этом iPad, но больше не будет следовать за компьютером."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kat planı bu iPad’de kalır ama artık bilgisayarı izlemez."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平面圖會保留在這台 iPad 上，但不再跟隨電腦同步。"
          }
        }
      }
    },
