    "That is not a House Control pairing code." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist kein House Control-Kopplungscode."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
