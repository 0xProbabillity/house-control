    "Sign in with your Smart Life or Tuya Smart account and the lamps and air conditioners linked to it in your floor plan become the real ones." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich mit deinem Smart Life- oder Tuya Smart-Konto an, und die damit verknüpften Lampen und Klimaanlagen in deinem Grundriss werden zu den echten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνδεθείτε με τον λογαριασμό σας Smart Life ή Tuya Smart και τα φωτιστικά και τα κλιματιστικά που συνδέονται με αυτόν στην κάτοψή σας γίνονται τα πραγματικά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión con tu cuenta de Smart Life o Tuya Smart y las lámparas y los aires acondicionados vinculados a ella en tu plano pasarán a ser los reales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous avec votre compte Smart Life ou Tuya Smart, et les lampes et climatiseurs qui y sont liés dans votre plan deviennent réels."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi con il tuo account Smart Life o Tuya Smart e le lampade e i condizionatori collegati nella tua piantina diventano quelli reali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smart LifeまたはTuya Smartのアカウントでサインインすると、間取りでそのアカウントにリンクされたライトとエアコンが実物になります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Войдите с аккаунтом Smart Life или Tuya Smart, и привязанные к нему лампы и кондиционеры на плане станут настоящими."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smart Life veya Tuya Smart hesabınızla giriş yapın; kat planınızda bu hesaba bağlı lambalar ve klimalar gerçek cihazlar olur."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用你的 Smart Life 或 Tuya Smart 帳號登入，平面圖中連結到它的燈和冷氣就會成為真實裝置。"
          }
        }
      }
    },
