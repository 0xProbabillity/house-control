    "Its devices go back to being simulated, here and on your paired computer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seine Geräte werden wieder simuliert, hier und auf deinem gekoppelten Computer."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι συσκευές του επιστρέφουν σε προσομοίωση, εδώ και στον συζευγμένο υπολογιστή σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
