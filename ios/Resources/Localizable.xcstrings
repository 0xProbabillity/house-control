    "Home Assistant" : {
      "shouldTranslate" : false
    },
    "Home Assistant, Hue and Homebridge set up here or on your paired computer work on both, shared over your encrypted link." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home Assistant, Hue und Homebridge, hier oder auf deinem gekoppelten Computer eingerichtet, funktionieren auf beiden – geteilt über eure verschlüsselte Verbindung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Home Assistant, το Hue και το Homebridge που ρυθμίζονται εδώ ή στον συζευγμένο υπολογιστή σας λειτουργούν και στα δύο, μέσω της κρυπτογραφημένης σύνδεσής σας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home Assistant, Hue y Homebridge, configurados aquí o en tu ordenador enlazado, funcionan en los dos y se comparten a través de vuestro enlace cifrado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home Assistant, Hue et Homebridge, configurés ici ou sur votre ordinateur jumelé, fonctionnent sur les deux, partagés via votre liaison chiffrée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home Assistant, Hue e Homebridge, configurati qui o sul computer abbinato, funzionano su entrambi, condivisi tramite il collegamento crittografato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここかペアリングしたコンピュータで設定したHome Assistant、Hue、Homebridgeは、暗号化されたリンクで共有され、両方で使えます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home Assistant, Hue и Homebridge, настроенные здесь или на связанном компьютере, работают на обоих — через ваш зашифрованный канал."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Burada veya eşlenmiş bilgisayarınızda kurulan Home Assistant, Hue ve Homebridge, şifreli bağlantınız üzerinden paylaşılarak ikisinde de çalışır."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在這裡或你配對的電腦上設定的 Home Assistant、Hue 和 Homebridge，兩邊都能使用，透過你的加密連線共用。"
          }
        }
      }
    },
    "Home Assistant, Philips Hue, Homebridge and Apple Home. Until you connect one, everything is simulated." : {
      "comment" : "Welcome screen",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home Assistant, Philips Hue, Homebridge und Apple Home. Bis du eines verbindest, ist alles simuliert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home Assistant, Philips Hue, Homebridge και Apple Home. Μέχρι να συνδέσετε ένα από αυτά, όλα είναι σε προσομοίωση."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home Assistant, Philips Hue, Homebridge y Apple Home. Hasta que conectes uno, todo es simulado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home Assistant, Philips Hue, Homebridge et Apple Home. Tant que vous n’en connectez aucun, tout est simulé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home Assistant, Philips Hue, Homebridge e Apple Home. Finché non ne connetti uno, è tutto simulato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home Assistant、Philips Hue、Homebridge、Apple Home。接続するまでは、すべてシミュレーションです。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home Assistant, Philips Hue, Homebridge и Apple Home. Пока вы ничего не подключили, всё работает в режиме имитации."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home Assistant, Philips Hue, Homebridge ve Apple Home. Birini bağlayana kadar her şey simüle edilir."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home Assistant、Philips Hue、Homebridge 和 Apple Home。在你連接之前，一切都是模擬的。"
          }
        }
      }
    },
    "Homebridge" : {
      "shouldTranslate" : false
    },
    "Homebridge ended the session and asks for a two-factor code. Sign in again to keep controlling its devices." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebridge hat die Sitzung beendet und verlangt einen Zwei-Faktor-Code. Melde dich erneut an, um seine Geräte weiter zu steuern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Homebridge τερμάτισε τη συνεδρία και ζητά κωδικό δύο παραγόντων. Συνδεθείτε ξανά για να συνεχίσετε να ελέγχετε τις συσκευές του."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebridge ha cerrado la sesión y pide un código de verificación en dos pasos. Vuelve a iniciar sesión para seguir controlando sus dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebridge a mis fin à la session et demande un code à deux facteurs. Reconnectez-vous pour continuer à piloter ses appareils."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebridge ha chiuso la sessione e chiede un codice a due fattori. Accedi di nuovo per continuare a controllarne i dispositivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebridgeがセッションを終了し、2ファクタ認証コードを求めています。デバイスの操作を続けるには、もう一度サインインしてください。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebridge завершил сеанс и просит код двухфакторной проверки. Войдите снова, чтобы и дальше управлять его устройствами."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebridge oturumu sonlandırdı ve iki adımlı doğrulama kodu istiyor. Cihazlarını kontrol etmeye devam etmek için yeniden oturum açın."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Homebridge 已結束工作階段，並要求輸入雙重認證碼。請重新登入，才能繼續控制它的裝置。"
          }
        }
      }
    },
