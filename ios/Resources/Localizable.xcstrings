    "Changes are saved at once and reach %@." : {
      "comment" : "Devices: the placeholder is the paired computer's name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Änderungen werden sofort gesichert und erreichen %@."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι αλλαγές αποθηκεύονται αμέσως και φτάνουν στο %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cambios se guardan al instante y llegan a %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modifications sont enregistrées immédiatement et parviennent à %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modifiche vengono salvate subito e arrivano a %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変更はすぐに保存され、%@にも反映されます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
