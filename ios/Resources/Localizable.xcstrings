    "Make your own home here, or pair with House Control on a Mac or PC and the one drawn there arrives by itself." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstelle hier dein eigenes Zuhause oder kopple House Control mit einem Mac oder PC – das dort gezeichnete kommt dann von selbst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δημιουργήστε το δικό σας σπίτι εδώ ή κάντε σύζευξη με το House Control σε Mac ή PC και όποιο σχεδιάσετε εκεί θα έρθει μόνο του."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea tu propia casa aquí, o enlaza con House Control en un Mac o PC y la que dibujes allí llegará sola."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez votre propre domicile ici, ou jumelez avec House Control sur un Mac ou un PC et celui dessiné là-bas arrivera tout seul."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea qui la tua casa, oppure abbinati a House Control su un Mac o PC e quella disegnata lì arriverà da sola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここで自分のホームを作るか、MacまたはPCのHouse Controlとペアリングすると、そちらで描いたホームが自動的に届きます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создайте свой дом здесь или свяжите приложение с House Control на Mac или ПК — нарисованный там дом придёт сам."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kendi evinizi burada oluşturun ya da bir Mac veya PC’deki House Control ile eşleyin; orada çizilen ev kendiliğinden gelir."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在這裡建立你自己的家，或與 Mac 或 PC 上的 House Control 配對，在那裡畫好的家就會自動傳過來。"
          }
        }
      }
    },
