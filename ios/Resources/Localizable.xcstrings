          "stringUnit" : {
            "state" : "translated",
            "value" : "そのデバイスは、ここでもペアリングしたコンピュータでもシミュレーションに戻ります。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
