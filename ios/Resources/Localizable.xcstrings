        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνδέθηκε. Σχεδιάστε το σπίτι σας εδώ ή στον υπολογιστή· εμφανίζεται και στα δύο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conectado. Dibuja tu casa aquí o en el ordenador; aparecerá en los dos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connecté. Dessinez votre domicile ici ou sur l’ordinateur ; il apparaît sur les deux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connesso. Disegna la tua casa qui o sul computer: appare su entrambi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続しました。ホームはここでもコンピュータでも描けて、両方に表示されます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключено. Рисуйте дом здесь или на компьютере — он появится на обоих."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlandı. Evinizi burada veya bilgisayarda çizin; ikisinde de görünür."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已連線。在這裡或電腦上繪製你的家，兩邊都會出現。"
          }
        }
      }
    },
    "Connected. Your floor plan now stays the same on both, whichever one you edit." : {
      "localizations" : {
