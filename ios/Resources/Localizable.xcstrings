    "Lights, colours, air conditioners and scenes, right on the floor plan." : {
      "comment" : "Welcome screen",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lichter, Farben, Klimaanlagen und Szenen – direkt auf dem Grundriss."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
