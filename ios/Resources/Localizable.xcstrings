    "Walk along the walls" : {
      "comment" : "Scan tips: title",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geh an den Wänden entlang"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Περπατήστε κατά μήκος των τοίχων"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recorre las paredes"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Longez les murs"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cammina lungo le pareti"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "壁に沿って歩く"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Идите вдоль стен"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duvarlar boyunca yürüyün"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沿著牆走"
          }
        }
      }
    },
    "Walk slowly along the walls. Point the circle at a lamp or an AC and tap +" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geh langsam an den Wänden entlang. Richte den Kreis auf eine Lampe oder Klimaanlage und tippe auf +"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Περπατήστε αργά κατά μήκος των τοίχων. Στρέψτε τον κύκλο σε φωτιστικό ή κλιματιστικό και αγγίξτε +"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recorre despacio las paredes. Apunta el círculo a una lámpara o un aire acondicionado y toca +"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Longez lentement les murs. Pointez le cercle vers une lampe ou un climatiseur et touchez +"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cammina lentamente lungo le pareti. Punta il cerchio su una lampada o un condizionatore e tocca +"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "壁に沿ってゆっくり歩きます。円をライトかエアコンに向けて+をタップ"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Медленно идите вдоль стен. Наведите круг на лампу или кондиционер и нажмите +"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duvarlar boyunca yavaşça yürüyün. Daireyi bir lambaya veya klimaya doğrultup + düğmesine dokunun"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沿著牆面慢慢走。將圓圈對準燈或冷氣並點一下 +"
          }
        }
      }
    },
    "Walk through it with the camera; lamps and ACs pinned on the way" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geh mit der Kamera hindurch; Lampen und Klimaanlagen markierst du unterwegs"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
