    "Slowly, the camera at chest height, pointing at the walls, the floor and the furniture." : {
      "comment" : "Scan tips",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langsam, die Kamera auf Brusthöhe, auf Wände, Boden und Möbel gerichtet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αργά, με την κάμερα στο ύψος του στήθους, στραμμένη στους τοίχους, στο πάτωμα και στα έπιπλα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Despacio, con la cámara a la altura del pecho, apuntando a las paredes, el suelo y los muebles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lentement, l’appareil à hauteur de poitrine, pointé vers les murs, le sol et les meubles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lentamente, con la fotocamera all’altezza del petto, puntata su pareti, pavimento e mobili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゆっくりと、カメラを胸の高さに構えて、壁、床、家具に向けます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Медленно, камера на уровне груди, направлена на стены, пол и мебель."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yavaşça, kamera göğüs hizasında; duvarlara, zemine ve mobilyalara doğru tutarak."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "緩慢移動，相機保持在胸口高度，對準牆面、地板和家具。"
          }
        }
      }
    },
