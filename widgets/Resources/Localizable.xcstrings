    "Your home in 3D, lit the way it is right now. Tap a lamp in the large sizes to switch it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Zuhause in 3D, beleuchtet wie gerade jetzt. Tippe in den großen Größen auf eine Lampe, um sie zu schalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το σπίτι σας σε 3D, φωτισμένο όπως είναι αυτή τη στιγμή. Στα μεγάλα μεγέθη, αγγίξτε ένα φωτιστικό για άναμμα ή σβήσιμο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu casa en 3D, iluminada tal como está ahora mismo. En los tamaños grandes, toca una lámpara para encenderla o apagarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre domicile en 3D, éclairé comme en ce moment. Dans les grandes tailles, touchez une lampe pour l’allumer ou l’éteindre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua casa in 3D, illuminata com’è adesso. Nei formati grandi, tocca una lampada per accenderla o spegnerla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今の点灯状態そのままの3Dのホーム。大きいサイズではライトをタップして切り替えられます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш дом в 3D, освещённый так, как сейчас. В больших размерах можно коснуться лампы, чтобы переключить её."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eviniz 3D olarak, şu anki ışıklarıyla. Büyük boyutlarda açıp kapatmak için bir lambaya dokunun."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 3D 家，呈現此刻的燈光。在大尺寸中點一下燈即可開關。"
          }
        }
      }
    },
