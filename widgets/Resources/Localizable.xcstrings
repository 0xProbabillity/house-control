            "value" : "Gemütlich, Film, Nacht … ein Tippen stellt alle Lichter und Klimaanlagen ein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ζεστασιά, Ταινία, Νύχτα… ένα άγγιγμα ρυθμίζει όλα τα φώτα και τα κλιματιστικά."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cálido, Cine, Noche… un toque ajusta todas las luces y aires acondicionados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosy, Cinéma, Nuit… un toucher règle toutes les lumières et les climatiseurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intimo, Film, Notte… un tocco regola tutte le luci e i condizionatori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "くつろぎ、映画、おやすみ…ワンタップですべてのライトとエアコンを設定。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уют, Кино, Ночь… одно касание настраивает весь свет и кондиционеры."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rahat, Film, Gece… tek dokunuş tüm ışıkları ve klimaları ayarlar."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "溫馨、電影、晚安…點一下就設定好所有燈和冷氣。"
          }
        }
      }
    },
